Algoritmo Ejercicio_7
	num_pasajeros = 0
	valor_pasaje = 0
	total_pagar = 0

	Escribir "Ingrese el numero de pasajeros"
	Leer num_pasajeros
	Escribir "Ingrese el valor del pasaje"
	Leer valor_pasaje

	//PROCESO
	total_pagar = num_pasajeros * valor_pasaje

	//DATOS DE SALIDA
	Escribir "Numero de pasajeros: ", num_pasajeros
	Escribir "Valor del pasaje: ", valor_pasaje
	Escribir "Total a pagar: ", total_pagar
FinAlgoritmo