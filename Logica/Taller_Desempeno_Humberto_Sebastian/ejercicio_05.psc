Algoritmo Ejercicio_5
	base = 0
	exponente = 0
	resultado = 0

	Escribir "Ingrese el numero base"
	Leer base
	Escribir "Ingrese el exponente"
	Leer exponente

	//PROCESO
	resultado = base ^ exponente

	//DATOS DE SALIDA
	Escribir "Numero base: ", base
	Escribir "Exponente: ", exponente
	Escribir "El resultado es: ", resultado
FinAlgoritmo