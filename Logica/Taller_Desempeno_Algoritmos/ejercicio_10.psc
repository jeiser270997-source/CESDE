Algoritmo Ejercicio_10
	anio_nacimiento = 0
	anio_actual = 0
	edad = 0

	Escribir "Ingrese el ano de nacimiento"
	Leer anio_nacimiento
	Escribir "Ingrese el ano actual"
	Leer anio_actual

	//PROCESO
	edad = anio_actual - anio_nacimiento

	//DATOS DE SALIDA
	Escribir "Ano de nacimiento: ", anio_nacimiento
	Escribir "Ano actual: ", anio_actual
	Escribir "La edad aproximada de la persona es: ", edad, " anos."
FinAlgoritmo